generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  role        Role         @default(STUDENT)
  createdAt   DateTime     @default(now())
  rubrics     Rubric[]
  submissions Submission[]
  scores      Score[]
}

model Rubric {
  id          String       @id @default(cuid())
  title       String
  description String?
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  criteria    Criterion[]
  submissions Submission[]
}

model Criterion {
  id          String  @id @default(cuid())
  rubricId    String
  rubric      Rubric  @relation(fields: [rubricId], references: [id])
  name        String
  description String?
  maxPoints   Int
  order       Int
  scores      Score[]
}

model Submission {
  id          String      @id @default(cuid())
  studentId   String
  student     User        @relation(fields: [studentId], references: [id])
  rubricId    String
  rubric      Rubric      @relation(fields: [rubricId], references: [id])
  content     String
  submittedAt DateTime    @default(now())
  scores      Score[]
}

model Score {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
  criterionId  String
  criterion    Criterion  @relation(fields: [criterionId], references: [id])
  points       Int
  feedback     String?
  scoredById   String
  scoredBy     User       @relation(fields: [scoredById], references: [id])
  scoredAt     DateTime   @default(now())
}
